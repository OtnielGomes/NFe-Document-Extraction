# Copy this file to .env and set the key. .env is gitignored.
# scripts/run_eval.py loads .env without overriding variables already set.
# The local eval needs an OpenAI key. LangSmith is optional.
# GitHub Actions reads repository secrets, not this file. The manual OpenAI
# project budget (US$ 5/month, hard limit) is documented in docs/deploy.md.

OPENAI_API_KEY=

# Optional. When set, scripts/run_eval.py uploads the run as a LangSmith
# experiment. Model calls are traced only with --trace or LANGSMITH_TRACING=true.
# Sync the dataset first: uv run python scripts/sync_dataset.py
LANGSMITH_API_KEY=

# Set to false to disable tracing and the experiment upload for a run.
# LANGSMITH_TRACING=false

# Real invoices stay in data/real/ (gitignored): each folder has nfe.xml and
# danfe.pdf and/or phone-photo/page-*.jpg. scripts/run_real_eval.py forces
# tracing off and writes only aggregated origin `real` rows into docs/results.md.

# Snapshots for the eval approaches. Leave a line unset to use the pin
# in agents/models.json. An id must already be priced in that table.
#   gpt-4.1-mini-2025-04-14  the single-call baseline and text layer
#   gpt-4.1-2025-04-14       strong vision
#   gpt-6-luna               cheap vision. Rolling id (no dated snapshot).
#                            Responses API, reasoning effort none, temperature 0.
#                            Priced in agents/models.json, including cache writes.
NFE_BASELINE_MODEL=gpt-4.1-mini-2025-04-14
NFE_CHEAP_VISION_MODEL=gpt-6-luna
NFE_STRONG_VISION_MODEL=gpt-4.1-2025-04-14
NFE_TEXT_LAYER_MODEL=gpt-4.1-mini-2025-04-14
